verify_case <- function(n, p, label) {
cat("=====", label, sprintf("(n=%d, p=%d, m=min(n,p)=%d)", n, p, min(n,p)), "=====\n")
X <- matrix(rnorm(n * p), n, p)
A_g <- matrix(rnorm(p * p), p, p)
Gamma <- A_g %*% t(A_g) + diag(p) * 1e-3
cat("  min eigenvalue of Gamma:", min(eigen(Gamma, symmetric = TRUE, only.values = TRUE)$values), "\n")
L <- t(chol(Gamma))
B <- t(L)
g <- build_general_gsvd(X, B)
U <- g$U; V <- g$V; Z <- g$Z; C <- g$C; S <- g$S; m <- g$m
cat("  dim(U):", dim(U), " dim(V):", dim(V), " dim(Z):", dim(Z), "\n")
cat("  max|U'U - I|:", max(abs(t(U) %*% U - diag(n))), "\n")
cat("  max|V'V - I|:", max(abs(t(V) %*% V - diag(p))), "\n")
X_recon <- U %*% C %*% solve(Z)
B_recon <- V %*% S %*% solve(Z)
cat("  max|X - U C Z^{-1}|:", max(abs(X - X_recon)), "\n")
cat("  max|B - V S Z^{-1}|:", max(abs(B - B_recon)), "\n")
norm_check <- t(C) %*% C + S %*% S
cat("  max|C'C + S^2 - I_p|:", max(abs(norm_check - diag(p))), "\n")
w_hat <- rnorm(p)
y <- rnorm(n)
r <- y - X %*% w_hat
beta_direct <- as.vector(w_hat + solve(crossprod(X) + Gamma, t(X) %*% r))
beta_decoupled <- w_hat
for (j in 1:m) {
beta_decoupled <- beta_decoupled + Z[, j] * g$c[j] * sum(U[, j] * r)
}
cat("  max|beta_direct - beta_decoupled (m-term sum)|:",
max(abs(beta_direct - beta_decoupled)), "\n\n")
}
verify_case(15, 40, "p > n")
build_general_gsvd <- function(X, B) {
n <- nrow(X); p <- ncol(X)
m <- min(n, p)
Y <- X %*% solve(B)                    # Y = X B^{-1}, n x p
sv <- svd(Y, nu = n, nv = p)            # FULL SVD: U is n x n, V is p x p
U <- sv$u; V <- sv$v
rho <- sv$d                            # length m: genuine singular values of Y
c_vals <- rho / sqrt(1 + rho^2)        # length m, in [0, 1)
s_vals <- 1 / sqrt(1 + rho^2)          # length m, in (0, 1]
# C: n x p, diagonal pattern with c_vals on the leading m entries, zero elsewhere
C <- matrix(0, n, p)
for (j in 1:m) C[j, j] <- c_vals[j]
# S: p x p, diagonal; leading m entries = s_vals, remaining (p-m) entries = 1
# (only relevant when m = n < p: those extra directions carry NO information from X)
S <- diag(p)
for (j in 1:m) S[j, j] <- s_vals[j]
Z <- solve(B) %*% V %*% S              # Z = B^{-1} V S
list(U = U, V = V, Z = Z, C = C, S = S, c = c_vals, s = s_vals, m = m, n = n, p = p)
}
verify_case <- function(n, p, label) {
cat("=====", label, sprintf("(n=%d, p=%d, m=min(n,p)=%d)", n, p, min(n,p)), "=====\n")
X <- matrix(rnorm(n * p), n, p)
A_g <- matrix(rnorm(p * p), p, p)
Gamma <- A_g %*% t(A_g) + diag(p) * 1e-3
cat("  min eigenvalue of Gamma:", min(eigen(Gamma, symmetric = TRUE, only.values = TRUE)$values), "\n")
L <- t(chol(Gamma))
B <- t(L)
g <- build_general_gsvd(X, B)
U <- g$U; V <- g$V; Z <- g$Z; C <- g$C; S <- g$S; m <- g$m
cat("  dim(U):", dim(U), " dim(V):", dim(V), " dim(Z):", dim(Z), "\n")
cat("  max|U'U - I|:", max(abs(t(U) %*% U - diag(n))), "\n")
cat("  max|V'V - I|:", max(abs(t(V) %*% V - diag(p))), "\n")
X_recon <- U %*% C %*% solve(Z)
B_recon <- V %*% S %*% solve(Z)
cat("  max|X - U C Z^{-1}|:", max(abs(X - X_recon)), "\n")
cat("  max|B - V S Z^{-1}|:", max(abs(B - B_recon)), "\n")
norm_check <- t(C) %*% C + S %*% S
cat("  max|C'C + S^2 - I_p|:", max(abs(norm_check - diag(p))), "\n")
w_hat <- rnorm(p)
y <- rnorm(n)
r <- y - X %*% w_hat
beta_direct <- as.vector(w_hat + solve(crossprod(X) + Gamma, t(X) %*% r))
beta_decoupled <- w_hat
for (j in 1:m) {
beta_decoupled <- beta_decoupled + Z[, j] * g$c[j] * sum(U[, j] * r)
}
cat("  max|beta_direct - beta_decoupled (m-term sum)|:",
max(abs(beta_direct - beta_decoupled)), "\n\n")
}
verify_case(15, 40, "p > n")
verify_case(5, 100, "p >> n")
verify_case(40, 15, "n > p  (sanity check: original regime still works)")
verify_case(20, 20, "n = p  (boundary case)")
