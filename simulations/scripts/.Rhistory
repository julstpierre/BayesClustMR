tag_method <- function(res_list, method) {
bind_rows(res_list) %>%
mutate(method = method)
}
res_all <- bind_rows(
tag_method(lapply(chunk, fit_BayesClustMR), "BayesClustMR"),
tag_method(lapply(chunk, fit_mr_clust), "mr_clust")
)
res_all
