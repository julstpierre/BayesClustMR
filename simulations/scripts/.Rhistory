# Compute MSE
mse_matched <- function(theta_hat, true_vec) {
cost <- outer(theta_hat, true_vec, function(a, b) (a - b)^2)
assignment <- solve_LSAP(cost)
idx <- seq_len(min(length(theta_hat), length(true_vec)))
mean(cost[cbind(idx, assignment[idx])])
}
