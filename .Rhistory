r_w <- replicate(200, {
D <- sim_indv_dat(sim_params)
theta_hat <- D$beta_hat_y / D$beta_hat_x
ratios.se <- sqrt(D$sigma2_y / D$beta_hat_x^2 +
D$beta_hat_y^2 * D$sigma2_x / D$beta_hat_x^4)
w_i <- 1 / ratios.se
w_i <- w_i / sum(w_i) * D$p
sum(w_i * theta_hat) / sum(w_i)
})
summary(r_w)
