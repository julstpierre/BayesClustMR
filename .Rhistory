source("utils.R")
theta_true <- 0.1
n_reps     <- 100   # increase for tighter Monte Carlo error, e.g. 1000-2000
sim_params <- list(theta = theta_true, p = 30, n = 50000, q = 0.6, InSIDE = FALSE, pi = 0.3)
# storage
res <- data.frame(
rep         = 1:n_reps,
quantreg    = NA_real_,
median      = NA_real_,
cML         = NA_real_
)
for (i in 1:n_reps) {
D <- sim_indv_dat(sim_params)
## --- quantile regression MR estimator ---
fit_q <- tryCatch(fit_mr_quantreg(D, verbose = FALSE), error = function(e) NULL)
res$quantreg[i] <- if (!is.null(fit_q)) fit_q$Estimate else NA
## --- median MR estimator ---
fit_m <- tryCatch(fit_mr_median(D), error = function(e) NULL)
res$median[i] <- if (!is.null(fit_m)) fit_m$Estimate else NA
## --- cML MR estimator ---
fit_c <- tryCatch(fit_mr_cML(D), error = function(e) NULL)
res$cML[i] <- if (!is.null(fit_c)) fit_c$Estimate else NA
if (i %% 50 == 0) cat("rep", i, "done\n")
}
## --- summary: bias and RMSE ---
summarize_est <- function(est, theta_true) {
est <- est[!is.na(est)]
bias <- mean(est) - theta_true
rmse <- sqrt(mean((est - theta_true)^2))
se   <- sd(est)
data.frame(n_valid = length(est), mean_est = mean(est), bias = bias, rmse = rmse, sd = se)
}
rbind(
quantreg = summarize_est(res$quantreg, theta_true),
median   = summarize_est(res$median,   theta_true),
cML      = summarize_est(res$cML,      theta_true)
)
source("utils.R")
theta_true <- 0.1
n_reps     <- 100   # increase for tighter Monte Carlo error, e.g. 1000-2000
sim_params <- list(theta = theta_true, p = 30, n = 50000, q = 0.6, InSIDE = FALSE, pi = 0.5)
# storage
res <- data.frame(
rep         = 1:n_reps,
quantreg    = NA_real_,
median      = NA_real_,
cML         = NA_real_
)
for (i in 1:n_reps) {
D <- sim_indv_dat(sim_params)
## --- quantile regression MR estimator ---
fit_q <- tryCatch(fit_mr_quantreg(D, verbose = FALSE), error = function(e) NULL)
res$quantreg[i] <- if (!is.null(fit_q)) fit_q$Estimate else NA
## --- median MR estimator ---
fit_m <- tryCatch(fit_mr_median(D), error = function(e) NULL)
res$median[i] <- if (!is.null(fit_m)) fit_m$Estimate else NA
## --- cML MR estimator ---
fit_c <- tryCatch(fit_mr_cML(D), error = function(e) NULL)
res$cML[i] <- if (!is.null(fit_c)) fit_c$Estimate else NA
if (i %% 50 == 0) cat("rep", i, "done\n")
}
## --- summary: bias and RMSE ---
summarize_est <- function(est, theta_true) {
est <- est[!is.na(est)]
bias <- mean(est) - theta_true
rmse <- sqrt(mean((est - theta_true)^2))
se   <- sd(est)
data.frame(n_valid = length(est), mean_est = mean(est), bias = bias, rmse = rmse, sd = se)
}
rbind(
quantreg = summarize_est(res$quantreg, theta_true),
median   = summarize_est(res$median,   theta_true),
cML      = summarize_est(res$cML,      theta_true)
)
